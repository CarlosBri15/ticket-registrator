{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@ticket-registrator/shared": [
        "../shared/src/index.ts"
      ],
      "@ticket-registrator/shared/assets": [
        "../shared/src/assets.ts"
      ],
      "@ticket-registrator/shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
